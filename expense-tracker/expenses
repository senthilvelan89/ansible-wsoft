#!/usr/bin/env bash
# Launcher for the expense tracker so it can be run without installing anything.
# Usage: ./expenses add Coffee 4.50 Dining
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

python_bin="${PYTHON:-}"
if [[ -z "${python_bin}" ]]; then
  for candidate in python3 python; do
    if command -v "${candidate}" >/dev/null 2>&1; then
      python_bin="${candidate}"
      break
    fi
  done
fi

if [[ -z "${python_bin}" ]]; then
  echo "Python 3 was not found. On macOS run: xcode-select --install" >&2
  exit 1
fi

export PYTHONPATH="${here}${PYTHONPATH:+:${PYTHONPATH}}"
exec "${python_bin}" -m expense_tracker "$@"
